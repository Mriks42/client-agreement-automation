# Copy to backend/.env for local dev. Never commit .env.
APP_ENV=dev
APP_BASE_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agreements

# Any long random string in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-insecure-change-me

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high

# console = print emails to the log (dev). gmail_api = send for real (see scripts/gmail_auth.py).
EMAIL_BACKEND=console
EMAIL_PRODUCT_NAME=Kickoff
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

SENTRY_DSN=
RUN_WORKER=true

MAX_UPLOAD_MB=20
MAX_PAGES=60
LIBREOFFICE_BIN=soffice

# Set to enable /api/ops/* diagnostics (e.g. POST /api/ops/test-email). Leave empty to disable.
OPS_TOKEN=

FRONTEND_DIST=../frontend/dist
